LOG_LEVEL=INFO

# GraphQL backend this server introspects and queries.
GRAPHQL_BASE_URL=https://localhost:7000
GRAPHQL_VERIFY_SSL=false

# Optional — path to a schema file (SDL .graphql or JSON introspection). When
# set, tools are generated from the file at startup instead of a live schema
# fetch. Relative paths resolve against the project root.
SCHEMA_FILE=./demo-schema.graphql

# Static fallback token for local testing without a real OIDC provider.
DEV_TOKEN=

HOST=0.0.0.0
PORT=3001
MCP_TRANSPORT=stdio

# Set to 1 to auto-start the bundled mock GraphQL backend alongside the MCP
# server. Auto-sets GRAPHQL_BASE_URL and SCHEMA_FILE when not already defined.
# MOCK_BACKEND=1
# MOCK_BACKEND_PORT=4000

# Optional — only needed if you want the MCP server to validate incoming
# Bearer tokens itself before forwarding them upstream. Leave blank to skip
# validation (token is forwarded as-is).
# OIDC_DISCOVERY_URL=https://login.microsoftonline.com/<tenant>/v2.0/.well-known/openid-configuration
# OIDC_AUDIENCE=<expected-audience>
